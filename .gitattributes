# Normalize line endings for text files.
* text=auto eol=lf

# Source and docs
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cff  text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.parquet binary
*.arrow binary
*.gguf binary
*.safetensors binary
*.pt   binary
*.bin  binary

# Mark generated files so diffs stay readable
artifacts/ledger.csv linguist-generated=true
artifacts/claims_evidence.csv linguist-generated=true
runs/registry.csv linguist-generated=true
